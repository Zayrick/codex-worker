{
	"name": "codex-worker",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.18.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "pnpm run build:worker:dev && vite",
		"build": "pnpm run build:worker && pnpm run build:vite",
		"build:vite": "tsc -b tsconfig.app.json tsconfig.node.json && vite build",
		"build:worker": "cd worker-rs && worker-build --release",
		"build:worker:dev": "cd worker-rs && worker-build --dev",
		"lint": "oxlint",
		"preview": "pnpm run build && vite preview",
		"deploy": "pnpm run build && wrangler deploy",
		"start": "pnpm run dev",
		"test": "pnpm run test:rust",
		"test:rust": "cargo test --manifest-path worker-rs/Cargo.toml --all-targets",
		"typecheck": "tsc -b tsconfig.app.json tsconfig.node.json",
		"check:rust": "cargo fmt --manifest-path worker-rs/Cargo.toml -- --check && cargo clippy --manifest-path worker-rs/Cargo.toml --all-targets -- -D warnings && cargo clippy --manifest-path worker-rs/Cargo.toml --target wasm32-unknown-unknown -- -D warnings",
		"check": "pnpm run lint && pnpm run test:rust && pnpm run check:rust && pnpm run build && wrangler deploy --dry-run"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.51.0",
		"@types/node": "^26.1.2",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.4",
		"oxlint": "^1.75.0",
		"typescript": "~6.0.2",
		"vite": "^8.2.0",
		"wrangler": "^4.119.0"
	},
	"dependencies": {
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	}
}
