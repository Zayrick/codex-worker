{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "codex-worker",
	"main": "worker-rs/build/index.js",
	"compatibility_date": "2026-08-06",
	// The Worker serves the admin shell only after matching the configured path.
	"assets": {
		"binding": "ASSETS",
		"html_handling": "none",
		"not_found_handling": "none",
		"run_worker_first": ["/index.html"]
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat",
		"enable_request_signal"
	],

	"vars": {
		"CORS_ORIGIN": "*"
	},

	// Required secrets for configuration validation and generated bindings.
	"secrets": {
		"required": [
			"ADMIN_PATH",
			"ADMIN_SECRET",
			"AUTH_PROXY_HOST",
			"BARK_PUSH_URL",
			"DINGTALK_SECRET",
			"DINGTALK_WEBHOOK_URL",
			"CHATGPT_RELAY_URL",
			"DATA_ENCRYPTION_KEY"
		]
	},

	"kv_namespaces": [
		{
			"binding": "AUTH_KV"
		}
	],

	"triggers": {
		"crons": ["*/5 * * * *"]
	}
}
