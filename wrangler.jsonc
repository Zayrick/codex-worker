/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "codex-worker",
	"main": "worker-rs/build/index.js",
	"compatibility_date": "2026-08-06",
	// Vite builds the generated Rust/Wasm entry and the client assets together.
	// The Rust Worker fetches index.html
	// through this binding after matching the secret management path; routing
	// /index.html through the Worker prevents direct access to the admin shell.
	"assets": {
		"binding": "ASSETS",
		"html_handling": "none",
		"not_found_handling": "none",
		"run_worker_first": ["/index.html"]
	},
	// Persist structured Worker logs and upload source maps for readable production traces.
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		// Keep Node.js compatibility available to generated glue and dependencies.
		"nodejs_compat",
		// Makes the incoming Request.signal available so client disconnects can cancel upstream work.
		"enable_request_signal"
	],

	// Non-secret application configuration may be committed under vars.
	"vars": {
		"CORS_ORIGIN": "*"
	},

	// Local development and deployed environments supply these required values as secrets.
	// The Worker appends every upstream path to CHATGPT_RELAY_URL.
	// Required names support configuration validation and generated Env types.
	"secrets": {
		"required": [
			"ADMIN_PATH",
			"ADMIN_SECRET",
			"AUTH_PROXY_HOST",
			"BARK_PUSH_URL",
			"CHATGPT_RELAY_URL",
			"DATA_ENCRYPTION_KEY"
		]
	},

	// Stores encrypted API-key, OAuth credential, and Codex usage envelopes.
	"kv_namespaces": [
		{
			"binding": "AUTH_KV"
		}
	],

	// Sample Codex usage and check OAuth refresh every five minutes.
	"triggers": {
		"crons": ["*/5 * * * *"]
	}

	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": { "mode": "smart" },

	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources such as databases,
	 * object storage, AI inference, real-time communication, and other Workers.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */

	/**
	 * Environment Variables
	 * Use vars only for non-secret configuration. Store credentials as secrets.
	 * https://developers.cloudflare.com/workers/configuration/environment-variables/
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */

	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/service-bindings/
	 */
	// "services": [{ "binding": "MY_SERVICE", "service": "my-service" }]
}
